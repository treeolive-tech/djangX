[project]
name = "{{ project_name }}"
version = "0.1.0"
readme = "README.md"
requires-python = ">=3.14,<3.15"
dependencies = ["djangx{% if vercel %}[postgres,vercel]{% endif %}>=0.1.0.dev16"]
{% if vercel %}
[tool.vercel.scripts]
build = "npm i -g sass-embedded && djx sass --build && djx makemigrations && djx migrate"
{% endif %}